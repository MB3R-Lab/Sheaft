{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MB3R-Lab/Sheaft/api/schema/analysis.schema.json",
  "title": "SheaftAnalysisConfigV1",
  "type": "object",
  "required": [
    "schema_version",
    "profiles",
    "gate"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0", "1.1", "1.2"]
    },
    "seed": {
      "type": "integer"
    },
    "trials": {
      "type": "integer",
      "minimum": 1
    },
    "sampling_mode": {
      "type": "string",
      "enum": [
        "independent_replica",
        "independent_service",
        "fixed_k_service_set",
        "fixed_k_replica_slots"
      ]
    },
    "failure_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reliability": {
      "$ref": "#/$defs/reliability"
    },
    "fixed_k_failures": {
      "type": "integer",
      "minimum": 0
    },
    "journeys": {
      "type": "string"
    },
    "predicate_contract": {
      "type": "string"
    },
    "fault_contract": {
      "type": "string"
    },
    "endpoint_weights": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "baselines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "contract_policy": {
      "$ref": "contract-policy.schema.json"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "trials": {
            "type": "integer",
            "minimum": 1
          },
          "sampling_mode": {
            "type": "string",
            "enum": [
              "independent_replica",
              "independent_service",
              "fixed_k_service_set",
              "fixed_k_replica_slots"
            ]
          },
          "failure_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reliability": {
            "$ref": "#/$defs/reliability"
          },
          "fixed_k_failures": {
            "type": "integer",
            "minimum": 0
          },
          "fault_profile": {
            "type": "string"
          },
          "endpoint_weights": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "sweeps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "profile", "axis", "targets"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "profile": { "type": "string", "minLength": 1 },
          "confidence_level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
          "axis": {
            "type": "object",
            "required": ["type", "values"],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "independent_replica_failure_probability",
                  "failed_replica_slots"
                ]
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "number", "minimum": 0 }
              }
            }
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["endpoint_id", "slo"],
              "properties": {
                "endpoint_id": { "type": "string", "minLength": 1 },
                "slo": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "mode",
        "default_action"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["warn", "fail", "report"]
        },
        "default_action": {
          "type": "string",
          "enum": ["warn", "fail", "report"]
        },
        "evaluation_rule": {
          "type": "string",
          "enum": ["all_profiles", "any_profile"]
        },
        "global_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "aggregate_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cross_profile_aggregate_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "endpoint_thresholds": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "profile_aggregate_thresholds": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "profile_endpoint_thresholds": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "boundary_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sweep", "endpoint_id"],
            "properties": {
              "sweep": { "type": "string", "minLength": 1 },
              "endpoint_id": { "type": "string", "minLength": 1 },
              "minimum_certified_tolerance": { "type": "number", "minimum": 0 },
              "baseline": { "type": "string", "minLength": 1 },
              "max_regression": { "type": "number", "minimum": 0 },
              "indeterminate_action": { "type": "string", "enum": ["warn", "fail", "report"] }
            },
            "anyOf": [
              { "required": ["minimum_certified_tolerance"] },
              { "required": ["baseline", "max_regression"] }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "reliability": {
      "type": "object",
      "properties": {
        "node_live_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "edge_live_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "services": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "edges": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
